    "@angular/compiler-cli": "^21.0.0",
    "@nx/angular": "^22.4.4",
    "@nx/devkit": "^22.4.4",
    "@nx/vite": "^22.4.4",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^25.2.0",
    "@types/uuid": "^11.0.0",
