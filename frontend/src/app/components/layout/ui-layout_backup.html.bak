<div class="prime-app-container">
    <!-- Top Toolbar (Fixed at Top) -->
    <p-toolbar
        styleClass="app-menubar bg-white text-dark border-none p-2 flex justify-content-between align-items-center shadow-2"
        [style]="{'z-index': '1101', 'position': 'relative'}">
        <div class="p-toolbar-group-start flex align-items-center gap-2">
            <p-button icon="pi pi-bars" (click)="toggleDrawer()" [text]="true" [rounded]="true"
                styleClass="text-color-secondary"></p-button>

            <a routerLink="/" class="logo-link text-dark no-underline">
                <span class="font-bold text-xl">Service Dashboard</span>
            </a>
        </div>

        <div class="p-toolbar-group-end flex align-items-center gap-2">
            @if (currentUser) {
            <div class="flex align-items-center gap-2">
                <p-button icon="pi pi-bell" [rounded]="true" [text]="true" (onClick)="notifSidebarVisible = true" pBadge
                    [value]="unreadCount().toString()" severity="danger"
                    [badgeDisabled]="unreadCount() === 0"></p-button>

                <span class="font-bold text-xl">{{ currentUser?.username }}</span>

                <p-button icon="pi pi-power-off" (click)="logout.emit()" [rounded]="true"
                    styleClass="text-color-secondary hover:surface-100" [text]="true"></p-button>
            </div>
            }
        </div>
    </p-toolbar>

    <!-- Left Drawer -->
    <p-drawer [(visible)]="visible" closable="false" position="left" [modal]="false" [autoZIndex]="false"
        [baseZIndex]="0" [style]="{width: '18rem', top: '60px', height: 'calc(100vh - 60px)', border: 'none'}">
        <ng-template #headless>
            <div class="h-full flex flex-column pt-3">
                <ul class="list-none p-0 m-0 overflow-hidden">
                    <li>
                        <a pRipple routerLink="/dashboard"
                            routerLinkActive="surface-100 text-primary font-bold border-left-3 border-primary"
                            [routerLinkActiveOptions]="{exact: true}"
                            class="flex align-items-center cursor-pointer p-3 border-round text-700 hover:surface-100 transition-duration-150 transition-colors w-full no-underline border-left-3 border-transparent">
                            <i class="pi pi-home mr-2 text-xl"></i>
                            <span class="font-medium">Dashboard</span>
                        </a>
                    </li>
                </ul>
                <div class="mt-4 mb-2 px-3 text-xs font-semibold text-color-secondary uppercase">Utilities</div>
                <ul class="list-none p-0 m-0 overflow-hidden">
                    <li>
                        <a pRipple routerLink="/form-builder"
                            routerLinkActive="surface-100 text-primary font-bold border-left-3 border-primary"
                            class="flex align-items-center cursor-pointer p-3 border-round text-700 hover:surface-100 transition-duration-150 transition-colors w-full no-underline border-left-3 border-transparent">
                            <i class="pi pi-file-edit mr-2 text-xl"></i>
                            <span class="font-medium">Form Builder</span>
                        </a>
                    </li>
                    <li>
                        <a pRipple routerLink="/policy-visualizer"
                            routerLinkActive="surface-100 text-primary font-bold border-left-3 border-primary"
                            class="flex align-items-center cursor-pointer p-3 border-round text-700 hover:surface-100 transition-duration-150 transition-colors w-full no-underline border-left-3 border-transparent">
                            <i class="pi pi-sitemap mr-2 text-xl"></i>
                            <span class="font-medium">Policy Visualizer</span>
                        </a>
                    </li>
                </ul>

                @if (isAdmin) {
                <div class="mt-4 mb-2 px-3 text-xs font-semibold text-color-secondary uppercase">Administration</div>
                <ul class="list-none p-0 m-0 overflow-hidden">
                    <li>
                        <a pRipple routerLink="/admin/data-sources"
                            routerLinkActive="surface-100 text-primary font-bold border-left-3 border-primary"
                            class="flex align-items-center cursor-pointer p-3 border-round text-700 hover:surface-100 transition-duration-150 transition-colors w-full no-underline border-left-3 border-transparent">
                            <i class="pi pi-database mr-2 text-xl"></i>
                            <span class="font-medium">Data Sources</span>
                        </a>
                    </li>
                    <li>
                        <a pRipple routerLink="/admin/sync-jobs"
                            routerLinkActive="surface-100 text-primary font-bold border-left-3 border-primary"
                            class="flex align-items-center cursor-pointer p-3 border-round text-700 hover:surface-100 transition-duration-150 transition-colors w-full no-underline border-left-3 border-transparent">
                            <i class="pi pi-sync mr-2 text-xl"></i>
                            <span class="font-medium">Sync Jobs</span>
                        </a>
                    </li>
                    <li>
                        <a pRipple routerLink="/admin/widgets"
                            routerLinkActive="surface-100 text-primary font-bold border-left-3 border-primary"
                            class="flex align-items-center cursor-pointer p-3 border-round text-700 hover:surface-100 transition-duration-150 transition-colors w-full no-underline border-left-3 border-transparent">
                            <i class="pi pi-th-large mr-2 text-xl"></i>
                            <span class="font-medium">Widgets</span>
                        </a>
                    </li>
                    <li>
                        <a pRipple routerLink="/admin/notifications"
                            routerLinkActive="surface-100 text-primary font-bold border-left-3 border-primary"
                            class="flex align-items-center cursor-pointer p-3 border-round text-700 hover:surface-100 transition-duration-150 transition-colors w-full no-underline border-left-3 border-transparent">
                            <i class="pi pi-bell mr-2 text-xl"></i>
                            <span class="font-medium">Notifications</span>
                        </a>
                    </li>
                    <li>
                        <a pRipple routerLink="/admin/users"
                            routerLinkActive="surface-100 text-primary font-bold border-left-3 border-primary"
                            class="flex align-items-center cursor-pointer p-3 border-round text-700 hover:surface-100 transition-duration-150 transition-colors w-full no-underline border-left-3 border-transparent">
                            <i class="pi pi-users mr-2 text-xl"></i>
                            <span class="font-medium">Users</span>
                        </a>
                    </li>
                </ul>
                }
            </div>
        </ng-template>
    </p-drawer>

    <!-- Right Notification Drawer -->
    <p-drawer [(visible)]="notifSidebarVisible" position="right" [style]="{width: '350px'}" [modal]="true"
        appendTo="body" [dismissible]="false" [autoZIndex]="true" [baseZIndex]="10000">
        <ng-template pTemplate="header">
            <div class="flex justify-content-between align-items-center w-full">
                <span class="font-bold text-xl">Notifications</span>
            </div>
        </ng-template>

        <div class="flex flex-column" *ngIf="unreadCount() > 0; else noNotifs">
            <div *ngFor="let n of notifications(); let i = index"
                class="notif-item flex justify-content-between align-items-start">
                <div class="flex-1 mr-2">
                    <div class="font-bold mb-1">{{ n.title }}</div>
                    <div class="mb-1 text-sm">{{ n.body }}</div>
                    <div class="notif-time">{{ n.timestamp | date:'shortTime' }}</div>
                </div>
                <p-button icon="pi pi-times" [rounded]="true" [text]="true" size="small" severity="secondary"
                    (onClick)="removeNotification(i)"></p-button>
            </div>
        </div>
        <ng-template #noNotifs>
            <div class="text-center p-4 text-500">No new notifications</div>
        </ng-template>
    </p-drawer>

    <!-- Main Content Wrapper with Push Effect -->
    <div class="main-content" [class.content-pushed]="visible">
        <div class="layout-content-wrapper">
            <!-- Main Content -->
            <div class="flex-1 p-3">
                <ng-content></ng-content>
            </div>
        </div>
    </div>
</div>
