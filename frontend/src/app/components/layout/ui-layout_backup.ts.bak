import { Component, inject, computed, Input, Output, EventEmitter } from '@angular/core';
import { CommonModule } from '@angular/common';
import { RouterOutlet, RouterLink, RouterLinkActive } from '@angular/router';
import { ButtonModule } from 'primeng/button';
import { DrawerModule } from 'primeng/drawer';
import { RippleModule } from 'primeng/ripple';
import { BadgeModule } from 'primeng/badge';
import { ToolbarModule } from 'primeng/toolbar';

import { AuthService } from '../../services/auth.service';
import { SessionNotificationService } from '../../services/session-notification.service';

@Component({
    selector: 'app-ui-layout',
    standalone: true,
    imports: [
        CommonModule, RouterLink, RouterLinkActive,
        ButtonModule, DrawerModule, RippleModule, BadgeModule, ToolbarModule
    ],
    templateUrl: './ui-layout.html',
    styles: [`
    .layout-container { display: flex; height: 100vh; overflow: hidden; }
    .sidebar { width: 250px; background: var(--surface-card); border-right: 1px solid var(--surface-border); display: flex; flex-direction: column; }
    .content { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: var(--surface-ground); }
    .topbar { height: 60px; background: var(--surface-card); border-bottom: 1px solid var(--surface-border); display: flex; align-items: center; padding: 0 1.5rem; justify-content: space-between; }
    .main-scroll { flex: 1; overflow-y: auto; padding: 1.5rem; }
    
    .nav-item { padding: 0.75rem 1rem; color: var(--text-color); text-decoration: none; display: flex; align-items: center; gap: 0.5rem; transition: background 0.2s; border-radius: 6px; margin-bottom: 2px; }
    .nav-item:hover { background: var(--surface-hover); }
    .nav-item.active { background: var(--primary-color); color: var(--primary-color-text); }
    .nav-item i { font-size: 1.1rem; }
    
    .notif-item { border-bottom: 1px solid var(--surface-border); padding: 1rem; }
    .notif-item:last-child { border-bottom: none; }
    .notif-time { font-size: 0.8rem; color: var(--text-color-secondary); }
    
    .main-content { transition: margin-left 0.3s; }
    .content-pushed { margin-left: 18rem; }
  `]
})
export class UiLayoutComponent {
    authService = inject(AuthService);
    sessionNotifService = inject(SessionNotificationService);

    @Input() currentUser: any;
    @Input() isAdmin: boolean = false;
    @Output() logout = new EventEmitter<void>();

    visible = false; // Left sidebar
    notifSidebarVisible = false; // Right notification pane

    notifications = this.sessionNotifService.notifications;
    unreadCount = computed(() => this.notifications().length);

    toggleDrawer() {
        this.visible = !this.visible;
    }

    removeNotification(index: number) {
        this.sessionNotifService.remove(index);
    }

    clearNotifications() {
        this.sessionNotifService.clearAll();
    }
}
